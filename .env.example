# Public build settings only; never put backend/API secrets in VITE_* variables.
VITE_API_BASE_URL=
# Public sitekey (never the secret). Empty disables the widget only in local dev.
# Local end-to-end tests may use Cloudflare's documented dummy sitekey.
VITE_TURNSTILE_SITE_KEY=
# Native Vite development; Compose overrides this to host.docker.internal.
FASTAPI_PROXY_TARGET=http://localhost:8000
